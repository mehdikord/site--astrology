// اسکیمای دیتابیس سایت فاطمه یوسفی
// قراردادها مطابق لاراول: نام جداول جمع و snake_case، کلید اصلی BIGINT UNSIGNED AUTO_INCREMENT،
// ستون‌های created_at / updated_at در همه‌ی جداول، کلیدهای خارجی به شکل {table}_id.
// مبالغ به تومان ذخیره می‌شوند.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────── مدیران و کاربران ───────────────────────────────

model Admin {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(255)
  mobile    String   @unique @db.VarChar(20)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  articles Article[]
  analyses Analysis[]

  @@map("admins")
}

enum Gender {
  male
  female
}

model User {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name      String?   @db.VarChar(255)
  mobile    String    @unique @db.VarChar(20)
  email     String?   @unique @db.VarChar(255)
  bio       String?   @db.Text
  avatar    String?   @db.VarChar(255)
  birthDate DateTime? @map("birth_date") @db.Date
  gender    Gender?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  orders           Order[]
  transactions     Transaction[]
  enrollments      CourseEnrollment[]
  analysisRequests AnalysisRequest[]
  testimonials     Testimonial[]
  contactMessages  ContactMessage[]
  lessonProgress   LessonProgress[]

  @@map("users")
}

// کدهای یک‌بار مصرف برای ورود/ثبت‌نام با موبایل
model VerificationCode {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  mobile    String    @db.VarChar(20)
  code      String    @db.VarChar(10)
  attempts  Int       @default(0) @db.UnsignedTinyInt
  expiresAt DateTime  @map("expires_at") @db.Timestamp(0)
  usedAt    DateTime? @map("used_at") @db.Timestamp(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([mobile])
  @@map("verification_codes")
}

// ─────────────────────────────── خدمات (تحلیل‌های قابل سفارش) ───────────────────────────────

model Service {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  slug             String   @unique @db.VarChar(255)
  icon             String?  @db.VarChar(50)
  title            String   @db.VarChar(255)
  titleEn          String?  @map("title_en") @db.VarChar(255)
  tagline          String?  @db.VarChar(255)
  shortDescription String?  @map("short_description") @db.Text
  intro            String?  @db.LongText
  image            String?  @db.VarChar(255)
  price            Int      @default(0) @db.UnsignedInt
  oldPrice         Int?     @map("old_price") @db.UnsignedInt
  duration         String?  @db.VarChar(255) // مثلا: گزارش ۳۰ صفحه‌ای + جلسه‌ی ۶۰ دقیقه‌ای
  format           String?  @db.VarChar(255)
  delivery         String?  @db.VarChar(255) // مثلا: ۳ تا ۵ روز کاری
  forWho           Json?    @map("for_who") // string[]
  deliverables     Json? // string[]
  requirements     Json? // string[] — اطلاعات مورد نیاز از مشتری
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  metaTitle        String?  @map("meta_title") @db.VarChar(255)
  metaDescription  String?  @map("meta_description") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  steps            ServiceStep[]
  faqs             ServiceFaq[]
  analysisRequests AnalysisRequest[]
  orderItems       OrderItem[]
  testimonials     Testimonial[]

  @@index([isActive, sortOrder])
  @@map("services")
}

model ServiceStep {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  serviceId   BigInt   @map("service_id") @db.UnsignedBigInt
  title       String   @db.VarChar(255)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_steps")
}

// سوالات متداول — service_id خالی یعنی سوال عمومی سایت
model ServiceFaq {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  serviceId BigInt?  @map("service_id") @db.UnsignedBigInt
  question  String   @db.VarChar(500)
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_faqs")
}

// ─────────────────────────────── درخواست تحلیل و تحلیل تحویلی ───────────────────────────────

enum BirthTimeAccuracy {
  exact
  approximate
  unknown
}

enum AnalysisRequestStatus {
  pending_payment // در انتظار پرداخت
  pending // پرداخت شده، در صف بررسی
  in_progress // در حال تحلیل
  completed // تحلیل تحویل شد
  canceled
}

// درخواست تحلیلی که کاربر با اطلاعات تولدش ثبت می‌کند
model AnalysisRequest {
  id                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  userId            BigInt                @map("user_id") @db.UnsignedBigInt
  serviceId         BigInt                @map("service_id") @db.UnsignedBigInt
  orderId           BigInt?               @map("order_id") @db.UnsignedBigInt
  fullName          String                @map("full_name") @db.VarChar(255)
  gender            Gender?
  birthDate         DateTime              @map("birth_date") @db.Date
  birthTime         DateTime?             @map("birth_time") @db.Time(0)
  birthTimeAccuracy BirthTimeAccuracy     @default(exact) @map("birth_time_accuracy")
  birthCity         String?               @map("birth_city") @db.VarChar(255)
  birthCountry      String?               @map("birth_country") @db.VarChar(255)
  questions         String?               @db.Text // سوال‌ها و دغدغه‌های اصلی
  extraInfo         Json?                 @map("extra_info") // سایر فیلدهای فرم بسته به نوع تحلیل
  status            AnalysisRequestStatus @default(pending_payment)
  adminNote         String?               @map("admin_note") @db.Text
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  analysis Analysis?

  @@index([userId])
  @@index([serviceId])
  @@index([orderId])
  @@index([status])
  @@map("analysis_requests")
}

// نتیجه‌ی تحلیل که مدیر برای یک درخواست تحویل می‌دهد (گزارش PDF + جلسه‌ی آنلاین)
model Analysis {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  analysisRequestId BigInt    @unique @map("analysis_request_id") @db.UnsignedBigInt
  adminId           BigInt?   @map("admin_id") @db.UnsignedBigInt
  title             String?   @db.VarChar(255)
  summary           String?   @db.LongText
  reportFile        String?   @map("report_file") @db.VarChar(255)
  sessionAt         DateTime? @map("session_at") @db.Timestamp(0)
  sessionLink       String?   @map("session_link") @db.VarChar(500)
  sessionDuration   Int?      @map("session_duration") @db.UnsignedSmallInt // دقیقه
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamp(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  request AnalysisRequest @relation(fields: [analysisRequestId], references: [id], onDelete: Cascade)
  admin   Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@map("analyses")
}

// ─────────────────────────────── دوره‌ها ───────────────────────────────

model Course {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  slug             String    @unique @db.VarChar(255)
  title            String    @db.VarChar(255)
  subtitle         String?   @db.VarChar(255)
  shortDescription String?   @map("short_description") @db.Text
  intro            String?   @db.LongText
  image            String?   @db.VarChar(255)
  introVideo       String?   @map("intro_video") @db.VarChar(500)
  level            String?   @db.VarChar(255)
  hours            Int       @default(0) @db.UnsignedSmallInt
  sessionsCount    Int       @default(0) @map("sessions_count") @db.UnsignedSmallInt
  format           String?   @db.VarChar(255)
  price            Int       @default(0) @db.UnsignedInt
  oldPrice         Int?      @map("old_price") @db.UnsignedInt
  badge            String?   @db.VarChar(100)
  learn            Json? // string[] — در این دوره چه یاد می‌گیری
  forWho           Json?     @map("for_who") // string[]
  includes         Json? // string[] — این دوره شامل
  isActive         Boolean   @default(true) @map("is_active")
  sortOrder        Int       @default(0) @map("sort_order")
  publishedAt      DateTime? @map("published_at") @db.Timestamp(0)
  metaTitle        String?   @map("meta_title") @db.VarChar(255)
  metaDescription  String?   @map("meta_description") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  chapters     CourseChapter[]
  enrollments  CourseEnrollment[]
  orderItems   OrderItem[]
  testimonials Testimonial[]

  @@index([isActive, sortOrder])
  @@map("courses")
}

// سرفصل‌های دوره
model CourseChapter {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  courseId    BigInt   @map("course_id") @db.UnsignedBigInt
  title       String   @db.VarChar(255)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId])
  @@map("course_chapters")
}

// درس‌های هر سرفصل
model CourseLesson {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  courseChapterId BigInt   @map("course_chapter_id") @db.UnsignedBigInt
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  videoUrl        String?  @map("video_url") @db.VarChar(500)
  attachment      String?  @db.VarChar(500)
  duration        Int?     @db.UnsignedInt // ثانیه
  isFree          Boolean  @default(false) @map("is_free") // پیش‌نمایش رایگان
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  chapter  CourseChapter    @relation(fields: [courseChapterId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([courseChapterId])
  @@map("course_lessons")
}

enum EnrollmentSource {
  purchase // خرید از سایت
  admin // اعطا توسط مدیر
  gift
}

// دسترسی کاربران به دوره‌های خریداری‌شده
model CourseEnrollment {
  id        BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt           @map("user_id") @db.UnsignedBigInt
  courseId  BigInt           @map("course_id") @db.UnsignedBigInt
  orderId   BigInt?          @map("order_id") @db.UnsignedBigInt
  source    EnrollmentSource @default(purchase)
  isActive  Boolean          @default(true) @map("is_active")
  expiresAt DateTime?        @map("expires_at") @db.Timestamp(0) // null = دسترسی دائمی
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([orderId])
  @@map("course_enrollments")
}

// پیشرفت کاربر در درس‌ها
model LessonProgress {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt    @map("user_id") @db.UnsignedBigInt
  courseLessonId BigInt    @map("course_lesson_id") @db.UnsignedBigInt
  watchedSeconds Int       @default(0) @map("watched_seconds") @db.UnsignedInt
  completedAt    DateTime? @map("completed_at") @db.Timestamp(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)

  @@unique([userId, courseLessonId])
  @@index([courseLessonId])
  @@map("lesson_progress")
}

// ─────────────────────────────── مقالات ───────────────────────────────

model ArticleCategory {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  articles Article[]

  @@map("article_categories")
}

enum ArticleStatus {
  draft
  published
}

model Article {
  id                BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  articleCategoryId BigInt?       @map("article_category_id") @db.UnsignedBigInt
  adminId           BigInt?       @map("admin_id") @db.UnsignedBigInt
  slug              String        @unique @db.VarChar(255)
  title             String        @db.VarChar(255)
  excerpt           String?       @db.Text
  image             String?       @db.VarChar(255)
  content           String        @db.LongText
  readTime          Int           @default(0) @map("read_time") @db.UnsignedSmallInt // دقیقه
  views             Int           @default(0) @db.UnsignedInt
  isFeatured        Boolean       @default(false) @map("is_featured")
  status            ArticleStatus @default(draft)
  publishedAt       DateTime?     @map("published_at") @db.Timestamp(0)
  metaTitle         String?       @map("meta_title") @db.VarChar(255)
  metaDescription   String?       @map("meta_description") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  category ArticleCategory? @relation(fields: [articleCategoryId], references: [id], onDelete: SetNull)
  author   Admin?           @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([articleCategoryId])
  @@index([adminId])
  @@index([status, publishedAt])
  @@map("articles")
}

// ─────────────────────────────── نظرات مشتریان و پیام‌های تماس ───────────────────────────────

// پیام/تجربه‌ی مشتریان برای نمایش در سایت
model Testimonial {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt?  @map("user_id") @db.UnsignedBigInt
  serviceId BigInt?  @map("service_id") @db.UnsignedBigInt
  courseId  BigInt?  @map("course_id") @db.UnsignedBigInt
  name      String   @db.VarChar(255) // مثلا: نگار م.
  subtitle  String?  @db.VarChar(255) // مثلا: تحلیل ماتریکس
  avatar    String?  @db.VarChar(255)
  content   String   @db.Text
  rating    Int      @default(5) @db.UnsignedTinyInt
  isActive  Boolean  @default(false) @map("is_active") // تایید شده برای نمایش
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([serviceId])
  @@index([courseId])
  @@index([isActive, sortOrder])
  @@map("testimonials")
}

// پیام‌های فرم تماس با ما
model ContactMessage {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt?   @map("user_id") @db.UnsignedBigInt
  name      String    @db.VarChar(255)
  contact   String    @db.VarChar(255) // شماره تماس یا ایمیل
  subject   String?   @db.VarChar(255)
  message   String    @db.Text
  readAt    DateTime? @map("read_at") @db.Timestamp(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("contact_messages")
}

// ─────────────────────────────── فاکتورها، تراکنش‌ها و کد تخفیف ───────────────────────────────

enum DiscountType {
  percent
  fixed
}

model DiscountCode {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  code        String       @unique @db.VarChar(50)
  type        DiscountType @default(percent)
  value       Int          @db.UnsignedInt // درصد یا مبلغ تومان
  maxDiscount Int?         @map("max_discount") @db.UnsignedInt
  minAmount   Int?         @map("min_amount") @db.UnsignedInt
  usageLimit  Int?         @map("usage_limit") @db.UnsignedInt
  usedCount   Int          @default(0) @map("used_count") @db.UnsignedInt
  startsAt    DateTime?    @map("starts_at") @db.Timestamp(0)
  expiresAt   DateTime?    @map("expires_at") @db.Timestamp(0)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  orders Order[]

  @@map("discount_codes")
}

enum OrderStatus {
  pending // صادر شده، در انتظار پرداخت
  paid
  failed
  canceled
  refunded
}

// فاکتور خرید
model Order {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt      @map("user_id") @db.UnsignedBigInt
  discountCodeId BigInt?     @map("discount_code_id") @db.UnsignedBigInt
  orderNumber    String      @unique @map("order_number") @db.VarChar(50)
  subtotal       Int         @default(0) @db.UnsignedInt
  discountAmount Int         @default(0) @map("discount_amount") @db.UnsignedInt
  total          Int         @default(0) @db.UnsignedInt
  status         OrderStatus @default(pending)
  paidAt         DateTime?   @map("paid_at") @db.Timestamp(0)
  description    String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user             User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  discountCode     DiscountCode?      @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  transactions     Transaction[]
  enrollments      CourseEnrollment[]
  analysisRequests AnalysisRequest[]

  @@index([userId])
  @@index([discountCodeId])
  @@index([status])
  @@map("orders")
}

enum OrderItemType {
  course
  service
}

// اقلام فاکتور (دوره یا خدمت)
model OrderItem {
  id        BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  orderId   BigInt        @map("order_id") @db.UnsignedBigInt
  itemType  OrderItemType @map("item_type")
  courseId  BigInt?       @map("course_id") @db.UnsignedBigInt
  serviceId BigInt?       @map("service_id") @db.UnsignedBigInt
  title     String        @db.VarChar(255) // عنوان در لحظه‌ی خرید
  unitPrice Int           @map("unit_price") @db.UnsignedInt
  quantity  Int           @default(1) @db.UnsignedSmallInt
  discount  Int           @default(0) @db.UnsignedInt
  total     Int           @db.UnsignedInt
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([courseId])
  @@index([serviceId])
  @@map("order_items")
}

enum TransactionStatus {
  pending
  success
  failed
  canceled
}

// تراکنش‌های پرداخت (درگاه)
model Transaction {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt            @map("user_id") @db.UnsignedBigInt
  orderId         BigInt?           @map("order_id") @db.UnsignedBigInt
  amount          Int               @db.UnsignedInt
  gateway         String            @db.VarChar(50) // zarinpal, zibal, idpay, manual, ...
  authority       String?           @unique @db.VarChar(255) // توکن/شناسه‌ی درخواست پرداخت
  referenceId     String?           @map("reference_id") @db.VarChar(255) // کد رهگیری بانک
  cardNumber      String?           @map("card_number") @db.VarChar(30) // شماره کارت ماسک‌شده
  status          TransactionStatus @default(pending)
  description     String?           @db.Text
  gatewayResponse Json?             @map("gateway_response")
  paidAt          DateTime?         @map("paid_at") @db.Timestamp(0)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("transactions")
}

// ─────────────────────────────── تنظیمات سایت ───────────────────────────────

// اطلاعات تماس، شبکه‌های اجتماعی، آمار صفحه اصلی و ... (جایگزین data/site.ts)
model Setting {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key       String   @unique @db.VarChar(255)
  value     String?  @db.Text
  group     String   @default("general") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([group])
  @@map("settings")
}
