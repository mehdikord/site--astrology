# MySQL connection — used by both the app and Prisma CLI (migrations / seed)
# Use 127.0.0.1 rather than localhost; URL-encode special characters in the password (e.g. @ → %40)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/astrology"

# Public address of the site (needed behind nginx / reverse proxy for redirects and forms)
APP_URL="https://example.com"

# Admin panel session signing key (random, at least 32 chars)
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=
